# Bearer token for HTTP API (empty = no auth, open access)
TASTASTAS_AUTH_TOKEN=

# OpenAI-compatible API key (used when --embed-backend=openai)
# TASTASTAS_OPENAI_KEY=

# SPA directory override (default = embedded in binary)
# Run `cd frontend && npm ci && npm run build` before setting this
# TASTASTAS_SPA_DIR=frontend/dist

# Custom ports (optional)
HTTP_PORT=8080
GRAPH_PORT=9292

# Host workspace dir mounted at /workspaces in container (Docker only).
# Required for smooth Docker usage: the client and server live on different
# filesystems — the client sends host paths, the container only sees what is
# mounted. Setting this remaps client paths under the prefix to /workspaces/...,
# so you keep using normal host paths and never touch container-internal ones.
# Without it the server can't translate the paths you pass — they fail or walk
# an empty tree.
# HOST_WORKSPACE_DIR=/home/user/Workspace
