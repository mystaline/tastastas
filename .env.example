# Bearer token for HTTP API (empty = no auth, open access)
TASTASTAS_AUTH_TOKEN=

# OpenAI-compatible API key (used when --embed-backend=openai)
# TASTASTAS_OPENAI_KEY=

# SPA directory override (default = embedded in binary)
# Run `cd frontend && npm ci && npm run build` before setting this
# TASTASTAS_SPA_DIR=frontend/dist

# Custom ports (optional)
HTTP_PORT=8080
GRAPH_PORT=9292

# Host directory mounted at /workspaces in container (Docker only).
# This is the docker-side mount source; the app never reads it.
# WORKSPACE_MOUNT=/home/mystaline-dev/Workspace

# Embed backend override (docker-compose.yml default: none)
# Values: none | sidecar | openai | ollama
# TASTASTAS_EMBED=openai

# Background consolidation interval (empty = disabled)
# TASTASTAS_CONSOLIDATE=1h

# Private Go module resolution for gitrepo/codeast ingest (comma-separated)
# GOPRIVATE=gitea.tagsamurai.local,github.com/myorg/*

# --- docker-compose.prod.yml only ---

# Container image
# TASTASTAS_IMAGE=ghcr.io/mystaline/tastastas:latest

# OpenAI-compatible provider settings (prod compose defaults: OpenRouter)
# TASTASTAS_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# TASTASTAS_OPENAI_MODEL=nvidia/nemotron-3-embed-1b:free
